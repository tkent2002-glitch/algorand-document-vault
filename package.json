{
  "name": "algorand-document-vault",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:package": "npm run build && node tools/release/package-artifact.mjs",
    "security:production": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run && node --test tools/release/*.test.mjs",
    "test:artifact": "npm run release:package && playwright test --config=playwright.artifact.config.ts",
    "test:browser": "npm run build && playwright test",
    "test:browser:ci": "npm run build && playwright test --project=chromium --project=firefox --project=webkit",
    "test:browser:core": "npm run build && playwright test --project=chromium --project=edge --project=webkit",
    "test:browser:stable-chrome": "npm run build && playwright test --config=playwright.chrome.config.ts",
    "verify:tracked-content": "node tools/release/verify-tracked-content.mjs",
    "verify:release-readiness": "node tools/release/verify-release-readiness.mjs"
  },
  "dependencies": {
    "@perawallet/connect": "^1.6.0",
    "algosdk": "^3.7.0",
    "buffer": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "@perawallet/walletconnect": "1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
